  "captureSlots": {
    "Rig": {
      "about": "the whole device at one moment: every setting (Nab/…), reading (Reading/…) and trace (Trace/…) it reported",
      "producer": "PODS/POD.THICK/CAPTURE.Recorder/SRC/src/recorder.rs",
      "fields": {
        "device": "string",
        "ts": "number",
        "rig": "object"
      },
      "optional": {}
    },
    "Attention": {
      "about": "a device whose state word turned dead",
      "producer": "PODS/POD.THICK/CAPTURE.Recorder/SRC/src/recorder.rs",
      "fields": {
        "device": "string",
        "leaf": "string",
        "word": "string",
        "ts": "number"
      },
      "optional": {
        "was": "string|null"
      }
    },
    "RedFlag": {
      "about": "a VISA exchange ticket: slow, refused or timed out",
      "producer": "PODS/POD.THIN/WEB.OsApi/SRC/red_flags.py",
      "fields": {
        "device": "string",
        "id": "number",
        "kind": "string",
        "status": "string",
        "opened": "number",
        "last": "number"
      },
      "optional": {
        "command": "string|null",
        "why": "string|null",
        "code": "string|null",
        "count": "number|null"
      }
    },
    "Landing": {
      "about": "a generator landed on a tone",
      "producer": "PODS/POD.THIN/WEB.OsApi/SRC/tone_stepper.py",
      "fields": {
        "device": "string",
        "freq_hz": "number",
        "at": "number"
      },
      "optional": {
        "step": "number|null",
        "by": "string|null"
      }
    },
    "CatchUp": {
      "about": "one device on one rung after a landing: what it said, or why it said nothing",
      "producer": "PODS/POD.THIN/WEB.OsApi/SRC/tone_stepper.py",
      "fields": {
        "device": "string",
        "generator": "string",
        "landing": "number",
        "rung_s": "number",
        "command": "string",
        "asked": "number",
        "answered": "number|null",
        "value": "string|null",
        "error": "string|null"
      },
      "optional": {
        "freq_hz": "number|null"
      }
    },
    "Setup": {
      "about": "what a person called a device, why they record it, and the units they corrected",
      "producer": "PODS/POD.THIN/WEB.OsApi/SRC/osapi/routes_capture_setups.py (saved); PODS/POD.THICK/CAPTURE.Recorder/SRC/src/recorder.rs (restated on every reconnect)",
      "fields": {
        "device": "string",
        "ts": "number"
      },
      "optional": {
        "name": "string",
        "purpose": "string",
        "test": "string|null",
        "settings": "object",
        "units": "object",
        "aliases": "object",
        "by": "string"
      }
    },
    "Qualified": {
      "about": "the queries a device answered alone (winners) and refused (losers, never asked again)",
      "producer": "PODS/POD.THICK/CAPTURE.Recorder/SRC/src/recorder.rs",
      "fields": {
        "device": "string",
        "ts": "number",
        "winners": "array",
        "losers": "array"
      },
      "optional": {}
    }
  },
