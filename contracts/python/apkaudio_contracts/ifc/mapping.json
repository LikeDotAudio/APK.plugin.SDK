{
  "schema": "apk.ifc.mapping/1",
  "ifc_schema": "IFC4X3_ADD2",
  "standard": "ISO 16739-1:2024",
  "rule": [
    "THE HUB MAPPING TABLE (bim-core-3): every IFC writer and reader in APK.audio takes its IFC names from this file and nothing else. Every entity, enumeration value, property set, quantity set and property in it is checked against IFC4X3_ADD2 by contracts/python/tests/test_ifc_vocab.py (skipped when IfcOpenShell is not installed).",
    "A part is an IFC TYPE object. Its type is chosen in this order: the part's own ifc block (part.ifc, or ext.ifc while it is migrating) > the first rule in `classes` that matches > the part's category in `categories`. Rules match case-insensitively; `class` is a regex on part.class, `text` a regex on name + model + description, `category` an exact category. A class matching `noise_classes` counts as no class.",
    "USERDEFINED needs a word: ElementType on the type and ObjectType on the occurrence, or an EXPRESS rule fails. `element_type` gives it; `{class}` is replaced by the part's class (or its category when the class is noise).",
    "`entity: null` marks a part that is not a physical element (software, a protocol, an assumed fabric): no IFC type is written for it.",
    "A part's own ifc block may name the occurrence entity (ext.ifc writes 'IfcFlowInstrument'); the type is that name + 'Type'. `legacy_predefined` rewrites retired values (owner decision 3: VOLTMETER -> VOLTMETER_RMS).",
    "The occurrence class is the type's `occurrence` in `entities`. Weight goes to that entity's `qto` (IfcElementQuantity, GrossWeight as IfcQuantityWeight, kg); an entity whose IFC has no weight quantity set uses APK_BaseQuantities.GrossWeight (never a Qto_ name IFC does not define).",
    "Custom sets are APK_* (Pset_ and Qto_ are reserved). The APK_ properties used here are listed in `apk_properties` and declared in DATABASE.server.BIM SRC/tools/ifc/apk_psets.py (its test holds the two equal).",
    "Every dimension mm, weight kg, power W, voltage Vrms unless a unit is given (contracts/ifc/units.json)."
  ],
  "noise_classes": "^(none|.*\\(by (maker|ports)\\))$",
  "entities": {
    "IfcAudioVisualApplianceType": { "occurrence": "IfcAudioVisualAppliance", "qto": "Qto_AudioVisualApplianceBaseQuantities", "common": "Pset_AudioVisualApplianceTypeCommon", "electrical": true },
    "IfcCommunicationsApplianceType": { "occurrence": "IfcCommunicationsAppliance", "qto": "Qto_CommunicationsApplianceBaseQuantities", "common": "Pset_CommunicationsApplianceTypeCommon", "electrical": true },
    "IfcMobileTelecommunicationsApplianceType": { "occurrence": "IfcMobileTelecommunicationsAppliance", "qto": null, "common": "Pset_MobileTelecommunicationsApplianceTypeCommon", "electrical": true },
    "IfcFlowInstrumentType": { "occurrence": "IfcFlowInstrument", "qto": "Qto_FlowInstrumentBaseQuantities", "common": "Pset_FlowInstrumentTypeCommon", "electrical": true },
    "IfcDistributionBoardType": { "occurrence": "IfcDistributionBoard", "qto": null, "common": null, "electrical": true, "note": "4.3's board for any distribution system; DISTRIBUTIONFRAME is the patch panel (+ Pset_DistributionBoardTypeDistributionFrame.PortCapacity)." },
    "IfcElectricDistributionBoardType": { "occurrence": "IfcElectricDistributionBoard", "qto": "Qto_DistributionBoardBaseQuantities", "common": "Pset_DistributionBoardTypeCommon", "electrical": true },
    "IfcElectricFlowStorageDeviceType": { "occurrence": "IfcElectricFlowStorageDevice", "qto": "Qto_ElectricFlowStorageDeviceBaseQuantities", "common": "Pset_ElectricFlowStorageDeviceTypeCommon", "electrical": true },
    "IfcElectricApplianceType": { "occurrence": "IfcElectricAppliance", "qto": "Qto_ElectricApplianceBaseQuantities", "common": "Pset_ElectricApplianceTypeCommon", "electrical": true },
    "IfcTransformerType": { "occurrence": "IfcTransformer", "qto": "Qto_TransformerBaseQuantities", "common": "Pset_TransformerTypeCommon", "electrical": true },
    "IfcProtectiveDeviceType": { "occurrence": "IfcProtectiveDevice", "qto": "Qto_ProtectiveDeviceBaseQuantities", "common": "Pset_ProtectiveDeviceTypeCommon", "electrical": true },
    "IfcUnitaryControlElementType": { "occurrence": "IfcUnitaryControlElement", "qto": "Qto_UnitaryControlElementBaseQuantities", "common": "Pset_UnitaryControlElementTypeCommon", "electrical": true },
    "IfcControllerType": { "occurrence": "IfcController", "qto": "Qto_ControllerBaseQuantities", "common": "Pset_ControllerTypeCommon", "electrical": true },
    "IfcSwitchingDeviceType": { "occurrence": "IfcSwitchingDevice", "qto": "Qto_SwitchingDeviceBaseQuantities", "common": "Pset_SwitchingDeviceTypeCommon", "electrical": true },
    "IfcLightFixtureType": { "occurrence": "IfcLightFixture", "qto": "Qto_LightFixtureBaseQuantities", "common": "Pset_LightFixtureTypeCommon", "electrical": true },
    "IfcOutletType": { "occurrence": "IfcOutlet", "qto": "Qto_OutletBaseQuantities", "common": "Pset_OutletTypeCommon", "electrical": true },
    "IfcCableSegmentType": { "occurrence": "IfcCableSegment", "qto": "Qto_CableSegmentBaseQuantities", "common": "Pset_CableSegmentTypeCommon", "electrical": true, "note": "A real cable: two end ports, each end's connector and gender in Pset_CableSegmentConnector (ConnectorAType/BType, ConnectorAGender/BGender)." },
    "IfcCableFittingType": { "occurrence": "IfcCableFitting", "qto": "Qto_CableFittingBaseQuantities", "common": "Pset_CableFittingTypeCommon", "electrical": true },
    "IfcElementAssemblyType": { "occurrence": "IfcElementAssembly", "qto": null, "common": "Pset_ElementAssemblyCommon", "electrical": false },
    "IfcFurnitureType": { "occurrence": "IfcFurniture", "qto": null, "common": "Pset_FurnitureTypeCommon", "electrical": false },
    "IfcDiscreteAccessoryType": { "occurrence": "IfcDiscreteAccessory", "qto": null, "common": "Pset_ElementComponentCommon", "electrical": false },
    "IfcMechanicalFastenerType": { "occurrence": "IfcMechanicalFastener", "qto": null, "common": "Pset_ElementComponentCommon", "electrical": false, "note": "NominalDiameter / NominalLength are attributes (Pset_MechanicalFastenerCommon is gone in 4.3). Every drawn screw is square-drive (Robertson): say so in ElementType." },
    "IfcElectricGeneratorType": { "occurrence": "IfcElectricGenerator", "qto": "Qto_ElectricGeneratorBaseQuantities", "common": "Pset_ElectricGeneratorTypeCommon", "electrical": true },
    "IfcBuildingElementProxyType": { "occurrence": "IfcBuildingElementProxy", "qto": null, "common": "Pset_BuildingElementProxyCommon", "electrical": false }
  },
  "legacy_predefined": { "IfcFlowInstrumentType": { "VOLTMETER": "VOLTMETER_RMS" } },
  "weight_fallback": { "set": "APK_BaseQuantities", "quantity": "GrossWeight", "ifc": "IfcQuantityWeight", "unit": "kg" },
  "categories": {
    "Audio": { "entity": "IfcAudioVisualApplianceType", "predefined": "USERDEFINED", "element_type": "{class}" },
    "Microphones": { "entity": "IfcAudioVisualApplianceType", "predefined": "MICROPHONE" },
    "Video": { "entity": "IfcAudioVisualApplianceType", "predefined": "USERDEFINED", "element_type": "{class}" },
    "Network": { "entity": "IfcCommunicationsApplianceType", "predefined": "NETWORKAPPLIANCE" },
    "Control": { "entity": "IfcCommunicationsApplianceType", "predefined": "USERDEFINED", "element_type": "{class}" },
    "Power": { "entity": "IfcElectricApplianceType", "predefined": "USERDEFINED", "element_type": "{class}" },
    "Infrastructure": { "entity": "IfcBuildingElementProxyType", "predefined": "USERDEFINED", "element_type": "{class}" },
    "Test & Measurement": { "entity": "IfcFlowInstrumentType", "predefined": "USERDEFINED", "element_type": "{class}" },
    "Computing": { "entity": "IfcCommunicationsApplianceType", "predefined": "COMPUTER" },
    "Accessories": { "entity": "IfcDiscreteAccessoryType", "predefined": "USERDEFINED", "element_type": "{class}" },
    "Concepts": { "entity": null, "note": "Not a physical element: a schematic/dataflow concept (adapter, mux, ST 2022-7, logic). No IFC type is written; the twin is the IfcProjectLibrary carrying APK_Part (ROAD-3587/3588)." },
    "Other": { "entity": "IfcBuildingElementProxyType", "predefined": "USERDEFINED", "element_type": "{class}" }
  },
  "classes": [
    { "class": "^(software|protocol|dnssd|nmos|ravenna|avb|midi|serial_port|assumed fabric)$", "entity": null, "note": "Not a physical element: software, a protocol part or an assumed fabric. No IFC type is written." },

    { "class": "^(loudspeaker|smart speaker)$", "entity": "IfcAudioVisualApplianceType", "predefined": "SPEAKER", "class_pset": "Pset_AudioVisualApplianceTypeSpeaker" },
    { "class": "^amplifier$", "entity": "IfcAudioVisualApplianceType", "predefined": "AMPLIFIER", "class_pset": "Pset_AudioVisualApplianceTypeAmplifier" },
    { "class": "^dsp / mixer$", "entity": "IfcAudioVisualApplianceType", "predefined": "USERDEFINED", "element_type": "DSP / Mixer" },
    { "class": "^audio i/o$", "entity": "IfcAudioVisualApplianceType", "predefined": "USERDEFINED", "element_type": "Audio I/O" },
    { "class": "^communications$", "entity": "IfcAudioVisualApplianceType", "predefined": "COMMUNICATIONTERMINAL", "note": "Intercom stations and beltpacks." },
    { "class": "^wireless handheld transmitter$", "entity": "IfcAudioVisualApplianceType", "predefined": "MICROPHONE" },
    { "class": "^wireless bodypack transmitter$", "entity": "IfcAudioVisualApplianceType", "predefined": "USERDEFINED", "element_type": "Wireless Transmitter" },
    { "class": "^wireless$", "category": "Audio", "text": "transmitter|bodypack|beltpack", "entity": "IfcAudioVisualApplianceType", "predefined": "USERDEFINED", "element_type": "Wireless Transmitter" },
    { "class": "^wireless$", "category": "Audio", "entity": "IfcAudioVisualApplianceType", "predefined": "RECEIVER" },

    { "class": "mic set", "category": "Microphones", "entity": "IfcElementAssemblyType", "predefined": "ACCESSORY_ASSEMBLY", "note": "A set of microphones sold as one: an assembly aggregating MICROPHONE occurrences." },
    { "class": "wireless (microphone )?system", "category": "Microphones", "entity": "IfcElementAssemblyType", "predefined": "ACCESSORY_ASSEMBLY", "note": "Transmitter + receiver sold as one system." },

    { "class": "^display$", "text": "projector", "entity": "IfcAudioVisualApplianceType", "predefined": "PROJECTOR" },
    { "class": "^display$", "entity": "IfcAudioVisualApplianceType", "predefined": "DISPLAY" },
    { "class": "^camera$", "entity": "IfcAudioVisualApplianceType", "predefined": "CAMERA" },
    { "class": "^player / recorder$", "text": "record", "entity": "IfcAudioVisualApplianceType", "predefined": "RECORDINGEQUIPMENT" },
    { "class": "^(player / recorder|media player)$", "entity": "IfcAudioVisualApplianceType", "predefined": "PLAYER" },
    { "class": "^video processing$", "text": "router|matrix|switcher", "entity": "IfcAudioVisualApplianceType", "predefined": "SWITCHER" },
    { "class": "^video processing$", "entity": "IfcAudioVisualApplianceType", "predefined": "USERDEFINED", "element_type": "Video Processing" },
    { "class": "^sync & timing$", "entity": "IfcAudioVisualApplianceType", "predefined": "USERDEFINED", "element_type": "Sync & Timing" },
    { "class": "^conferencing$", "entity": "IfcAudioVisualApplianceType", "predefined": "COMMUNICATIONTERMINAL" },
    { "class": "^lighting$", "entity": "IfcLightFixtureType", "predefined": "DIRECTIONSOURCE" },
    { "class": "^rf & satellite$", "entity": "IfcCommunicationsApplianceType", "predefined": "USERDEFINED", "element_type": "RF & Satellite" },
    { "class": "^camera support$", "entity": "IfcDiscreteAccessoryType", "predefined": "USERDEFINED", "element_type": "Camera Support" },

    { "class": "^(switch|network)$", "text": "router", "entity": "IfcCommunicationsApplianceType", "predefined": "ROUTER" },
    { "class": "^switch$", "entity": "IfcCommunicationsApplianceType", "predefined": "IPNETWORKEQUIPMENT", "note": "An Ethernet switch: IPNETWORKEQUIPMENT (4.3)." },
    { "class": "^transceiver$", "entity": "IfcCommunicationsApplianceType", "predefined": "TRANSITIONCOMPONENT" },
    { "class": "^network$", "text": "\\bsfp|transceiver|media converter|\\bqsfp", "entity": "IfcCommunicationsApplianceType", "predefined": "TRANSITIONCOMPONENT", "note": "Optics and media converters change the transmission medium." },
    { "class": "^(network|wireless)$", "category": "Network", "text": "access point", "entity": "IfcMobileTelecommunicationsApplianceType", "predefined": "ACCESSPOINT" },
    { "class": "^network$", "text": "gateway", "entity": "IfcCommunicationsApplianceType", "predefined": "GATEWAY" },
    { "class": "^network$", "text": "switch", "entity": "IfcCommunicationsApplianceType", "predefined": "IPNETWORKEQUIPMENT" },
    { "class": "^network$", "text": "\\bhub\\b", "entity": "IfcCommunicationsApplianceType", "predefined": "NETWORKHUB" },
    { "class": "^network$", "text": "bridge", "entity": "IfcCommunicationsApplianceType", "predefined": "NETWORKBRIDGE" },
    { "class": "^network$", "text": "modem", "entity": "IfcCommunicationsApplianceType", "predefined": "MODEM" },

    { "class": "^(computer|computing)$", "entity": "IfcCommunicationsApplianceType", "predefined": "COMPUTER" },
    { "class": "^server & parts$", "text": "server", "entity": "IfcCommunicationsApplianceType", "predefined": "COMPUTER" },
    { "class": "^server & parts$", "entity": "IfcCommunicationsApplianceType", "predefined": "USERDEFINED", "element_type": "Server Part" },
    { "class": "^peripheral$", "text": "printer", "entity": "IfcCommunicationsApplianceType", "predefined": "PRINTER" },
    { "class": "^peripheral$", "text": "scanner", "entity": "IfcCommunicationsApplianceType", "predefined": "SCANNER" },
    { "class": "^peripheral$", "entity": "IfcCommunicationsApplianceType", "predefined": "INTELLIGENTPERIPHERAL" },

    { "class": "^(wall station|control surface|touch panel)$", "entity": "IfcUnitaryControlElementType", "predefined": "CONTROLPANEL", "note": "Owner 2026-11-06 (ROAD-3598): a wall station (EDITORS.SurfaceDesigner's plate), a control surface (keys, encoders, faders on a desk or a rack face: a Stream Deck) and a touch panel (EDITORS.TouchPanelBuilder's screen) are physical BIM parts; what each presents stays APK-native, by hash." },
    { "class": "^control$", "text": "touch ?panel|touch ?screen", "entity": "IfcUnitaryControlElementType", "predefined": "CONTROLPANEL" },
    { "class": "^control$", "text": "keypad", "entity": "IfcSwitchingDeviceType", "predefined": "KEYPAD" },
    { "class": "^control$", "text": "processor|controller", "entity": "IfcControllerType", "predefined": "PROGRAMMABLE" },

    { "category": "Power", "text": "\\bups\\b|uninterruptible", "entity": "IfcElectricFlowStorageDeviceType", "predefined": "UPS" },
    { "category": "Power", "text": "\\bpdu\\b|power distribution|rack ?power|\\bdistro\\b", "entity": "IfcElectricDistributionBoardType", "predefined": "DISTRIBUTIONBOARD", "note": "A PDU is a small distribution board: Pset_DistributionBoardTypeCommon, Qto_DistributionBoardBaseQuantities." },
    { "category": "Power", "text": "conditioner|surge", "entity": "IfcElectricDistributionBoardType", "predefined": "USERDEFINED", "element_type": "Power Conditioner" },
    { "category": "Power", "text": "breaker", "entity": "IfcProtectiveDeviceType", "predefined": "CIRCUITBREAKER" },
    { "category": "Power", "text": "charger", "entity": "IfcElectricFlowStorageDeviceType", "predefined": "RECHARGER" },
    { "category": "Power", "text": "battery", "entity": "IfcElectricFlowStorageDeviceType", "predefined": "BATTERY" },
    { "category": "Power", "text": "power supply|\\bpsu\\b", "entity": "IfcTransformerType", "predefined": "RECTIFIER", "note": "An AC-to-DC power supply." },

    { "class": "^patch panel$", "entity": "IfcDistributionBoardType", "predefined": "DISTRIBUTIONFRAME", "class_pset": "Pset_DistributionBoardTypeDistributionFrame" },
    { "class": "^rack & enclosure$", "entity": "IfcElementAssemblyType", "predefined": "USERDEFINED", "element_type": "EquipmentRack", "frame": { "entity": "IfcFurnitureType", "predefined": "TECHNICALCABINET" }, "note": "The rack is an assembly of the occurrences mounted in it (IfcRelAggregates); its empty frame is an IfcFurnitureType TECHNICALCABINET inside the assembly." },
    { "class": "^frame / chassis$", "entity": "IfcAudioVisualApplianceType", "predefined": "USERDEFINED", "element_type": "Card Frame" },
    { "class": "^panel & plate$", "text": "\\bpower\\b|\\bac\\b|duplex|\\bnema\\b", "entity": "IfcOutletType", "predefined": "POWEROUTLET" },
    { "class": "^panel & plate$", "text": "\\bdata\\b|network|rj-?45|ethernet|cat ?6|cat ?5", "entity": "IfcOutletType", "predefined": "DATAOUTLET" },
    { "class": "^panel & plate$", "entity": "IfcOutletType", "predefined": "AUDIOVISUALOUTLET" },
    { "class": "^furniture$", "text": "desk|console", "entity": "IfcFurnitureType", "predefined": "DESK" },
    { "class": "^furniture$", "text": "table", "entity": "IfcFurnitureType", "predefined": "TABLE" },
    { "class": "^furniture$", "text": "chair", "entity": "IfcFurnitureType", "predefined": "CHAIR" },
    { "class": "^furniture$", "text": "shel(f|ves)", "entity": "IfcFurnitureType", "predefined": "SHELF" },
    { "class": "^furniture$", "entity": "IfcFurnitureType", "predefined": "USERDEFINED", "element_type": "Technical Furniture" },
    { "class": "^staging & truss$", "entity": "IfcElementAssemblyType", "predefined": "TRUSS" },
    { "class": "^acoustic treatment$", "entity": "IfcDiscreteAccessoryType", "predefined": "SOUNDABSORPTION" },

    { "class": "^cable$", "text": "fib(er|re)|optical", "entity": "IfcCableSegmentType", "predefined": "OPTICALCABLESEGMENT" },
    { "class": "^cable$", "entity": "IfcCableSegmentType", "predefined": "CABLESEGMENT" },
    { "class": "^(mount & hardware|hardware & components)$", "text": "screw", "entity": "IfcMechanicalFastenerType", "predefined": "SCREW", "element_type": "Robertson (square-drive) screw", "note": "House rule: every screw is square-drive." },
    { "class": "^(mount & hardware|hardware & components)$", "text": "\\bbolt", "entity": "IfcMechanicalFastenerType", "predefined": "BOLT" },
    { "class": "^mount & hardware$", "entity": "IfcDiscreteAccessoryType", "predefined": "BRACKET" },
    { "class": "^hardware & components$", "entity": "IfcDiscreteAccessoryType", "predefined": "USERDEFINED", "element_type": "Hardware & Components" },
    { "class": "^accessory$", "text": "adapter|adaptor|converter", "entity": "IfcCableFittingType", "predefined": "TRANSITION", "note": "A passive connector adapter: one end port per side." },
    { "class": "^tool$", "entity": "IfcBuildingElementProxyType", "predefined": "USERDEFINED", "element_type": "Tool" },

    { "class": "^dmm$", "entity": "IfcFlowInstrumentType", "predefined": "VOLTMETER_RMS", "note": "Owner 2026-11-06: VOLTMETER parts become VOLTMETER_RMS." },
    { "class": "^counter$", "entity": "IfcFlowInstrumentType", "predefined": "FREQUENCYMETER" },
    { "category": "Test & Measurement", "entity": "IfcFlowInstrumentType", "predefined": "USERDEFINED", "element_type": "{class}" }
  ],
  "part_attributes": [
    { "field": "name", "attribute": "Name" },
    { "field": "description", "attribute": "Description" },
    { "field": "id", "attribute": "Tag", "note": "The part id <maker>/<model> is also the uuid5 key of the type's GlobalId." }
  ],
  "part_fields": [
    { "field": "manufacturer", "set": "Pset_ManufacturerTypeInformation", "property": "Manufacturer", "template_type": "P_SINGLEVALUE", "measure": "IfcLabel" },
    { "field": "model", "set": "Pset_ManufacturerTypeInformation", "property": "ModelReference", "template_type": "P_SINGLEVALUE", "measure": "IfcLabel" },
    { "field": "name", "set": "Pset_ManufacturerTypeInformation", "property": "ModelLabel", "template_type": "P_SINGLEVALUE", "measure": "IfcLabel" },
    { "field": "part_number", "set": "Pset_ManufacturerTypeInformation", "property": "ArticleNumber", "template_type": "P_SINGLEVALUE", "measure": "IfcIdentifier" },
    { "field": "power.voltage_v", "set": "Pset_ElectricalDeviceCommon", "property": "RatedVoltage", "template_type": "P_BOUNDEDVALUE", "measure": "IfcElectricVoltageMeasure", "unit": "Vrms", "note": "A single number is the SetPointValue; a range fills Lower/UpperBoundValue. Owner decision 2: the old key stays beside it, derived, never typed twice." },
    { "field": "power.current_a", "set": "Pset_ElectricalDeviceCommon", "property": "RatedCurrent", "template_type": "P_BOUNDEDVALUE", "measure": "IfcElectricCurrentMeasure", "unit": "A", "note": "Maximum draw is the UpperBoundValue." },
    { "field": "power.watts", "set": "Pset_ElectricalDeviceCommon", "property": "NominalPowerConsumption", "template_type": "P_SINGLEVALUE", "measure": "IfcPowerMeasure", "unit": "W" },
    { "field": "power.btu_hr", "set": "Pset_ElectricalDeviceCommon", "property": "HeatDissipation", "template_type": "P_SINGLEVALUE", "measure": "IfcPowerMeasure", "unit": "W", "derive": "btu_hr / 3.412", "note": "Heat is stored in W; btu_hr is the derived old key." },
    { "field": "physical.weight_kg", "set": "{qto}", "property": "GrossWeight", "template_type": "Q_WEIGHT", "measure": "IfcMassMeasure", "unit": "kg", "note": "{qto} is the entity's qto, else weight_fallback." },
    { "field": "physical.width_mm", "representation": "Body", "note": "With height_mm and depth_mm: one IfcExtrudedAreaSolid box in an IfcRepresentationMap on the type, mm." },
    { "field": "physical.height_mm", "representation": "Body" },
    { "field": "physical.depth_mm", "representation": "Body" },
    { "field": "physical.rack_units", "set": "APK_AVDevice", "property": "RackUnits", "template_type": "P_SINGLEVALUE", "measure": "IfcInteger" },
    { "field": "physical.mount", "set": "APK_Part", "property": "Mount", "template_type": "P_SINGLEVALUE", "measure": "IfcLabel" },
    { "field": "id", "set": "APK_Part", "property": "PartId", "template_type": "P_SINGLEVALUE", "measure": "IfcIdentifier" },
    { "field": "stage", "set": "APK_Part", "property": "Stage", "template_type": "P_SINGLEVALUE", "measure": "IfcLabel" },
    { "field": "category", "set": "APK_Part", "property": "Category", "template_type": "P_SINGLEVALUE", "measure": "IfcLabel" },
    { "field": "class", "set": "APK_Part", "property": "Class", "template_type": "P_SINGLEVALUE", "measure": "IfcLabel" },
    { "field": "symbol", "set": "APK_Part", "property": "Symbol", "template_type": "P_SINGLEVALUE", "measure": "IfcLabel" }
  ],
  "port": {
    "entity": "IfcDistributionPort",
    "predefined_type": "CABLE",
    "wireless_domains": [],
    "flow": { "input": "SINK", "output": "SOURCE", "connection": "SOURCEANDSINK", "supply": "SINK" },
    "system": {
      "audio": "AUDIOVISUAL", "video": "AUDIOVISUAL", "midi": "CONTROL", "signal": "SIGNAL",
      "network": "DATA", "control": "CONTROL", "clock": "SIGNAL", "power": "ELECTRICAL",
      "rf": "COMMUNICATION", "usb": "DATA", "mechanical": null
    },
    "earthing": { "match": "\\b(gnd|ground|chassis|earth)\\b", "system": "EARTHING", "flow": "SOURCEANDSINK", "note": "A terminal named for ground is EARTHING and SOURCEANDSINK whatever its side (audit finding 9)." },
    "fields": [
      { "field": "count", "note": "count > 1 expands into count IfcDistributionPort, one per terminal; the row stays APK_Terminal.Group." },
      { "field": "labels", "attribute": "Name", "note": "labels[n] names terminal n, else `<group> <n>`." },
      { "field": "index", "set": "Pset_DistributionPortCommon", "property": "PortNumber", "template_type": "P_SINGLEVALUE", "measure": "IfcInteger" },
      { "field": "connector", "set": "Pset_DistributionPortTypeCable", "property": "ElectricalConnectionType", "template_type": "P_ENUMERATEDVALUE", "measure": "IfcLabel", "vocabulary": "connectors.json" },
      { "field": "connector", "set": "Pset_DistributionPortTypeCable", "property": "ConnectionSubtype", "template_type": "P_SINGLEVALUE", "measure": "IfcLabel", "vocabulary": "connectors.json" },
      { "field": "connector", "set": "Pset_DistributionPortTypeCable", "property": "ConnectionGender", "template_type": "P_ENUMERATEDVALUE", "measure": "IfcLabel", "vocabulary": "connectors.json" },
